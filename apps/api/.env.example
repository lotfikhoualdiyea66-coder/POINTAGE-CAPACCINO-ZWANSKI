APP_NAME=Cappuccino Lac 1 Attendance
ENVIRONMENT=development
DATABASE_URL=sqlite:///./attendance_dev.db
# Supabase session pooler (replace with the dashboard connection details; URL-encode the password):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INITIAL_ADMIN_EMAIL=admin@cappuccino.example
INITIAL_ADMIN_PASSWORD=
TIMEZONE=Africa/Tunis
# Code typed on a new kiosk phone to link it to this server (keep it private).
KIOSK_PAIRING_CODE=
# Fernet key that encrypts stored face templates. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes enrolled faces unreadable (employees must re-enroll).
FACE_DATA_KEY=
